{
  "name": "webdev-tools",
  "version": "2.3.0",
  "description": "Privacy-first developer utilities - 20 tools, 6 languages, 100% client-side execution",
  "main": "index.php",
  "scripts": {
    "build": "bash build.sh",
    "deploy": "bash build-tools/deploy-ftp.sh",
    "deploy:dry": "bash build-tools/deploy-ftp.sh --dry-run",
    "verify:prod": "node build-tools/verify-prod.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check:i18n": "node build-tools/check-i18n.js",
    "lint": "eslint .",
    "test:browser": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RamonKaes/WebDev-Tools.git"
  },
  "keywords": [
    "developer-tools",
    "privacy",
    "client-side",
    "utilities",
    "web-tools",
    "uuid",
    "jwt",
    "base64",
    "json",
    "password-generator",
    "qr-code",
    "hash-generator",
    "rfc-compliant"
  ],
  "author": "Ramon Kaes",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RamonKaes/WebDev-Tools/issues"
  },
  "homepage": "https://webdev-tools.info",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "bootstrap": "^5.3.0",
    "csso-cli": "^4.0.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "sass": "^1.107.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  }
}
